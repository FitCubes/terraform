#!/bin/bash
sudo apt update
sudo apt install -y unzip curl
curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"
unzip awscliv2.zip
sudo ./aws/install
rm -rf awscliv2.zip aws

sudo apt install -y ca-certificates curl
sudo install -m 0755 -d /etc/apt/keyrings
sudo curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
sudo chmod a+r /etc/apt/keyrings/docker.asc

sudo tee /etc/apt/sources.list.d/docker.sources <<EOF
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: $(. /etc/os-release && echo "$${UBUNTU_CODENAME:-$VERSION_CODENAME}")
Components: stable
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/docker.asc
EOF

sudo apt update
sudo apt install  -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

REGION=${region}
DB_ADDRESS=$(aws ssm get-parameter --name "${db_address_ssm_name}" --region $REGION --query Parameter.Value --output text --with-decryption)
DB_USERNAME=$(aws ssm get-parameter --name "${db_username_ssm_name}" --region $REGION --query Parameter.Value --output text --with-decryption)
DB_PASSWORD=$(aws ssm get-parameter --name "${db_password_ssm_name}" --region $REGION --query Parameter.Value --output text --with-decryption)
REDIS_ADDRESS=$(aws ssm get-parameter --name "${redis_address_ssm_name}" --region $REGION --query Parameter.Value --output text --with-decryption)
DB_NAME=$(aws ssm get-parameter --name "${db_name_ssm_name}" --region $REGION --query Parameter.Value --output text --with-decryption)
JWT_SECRET=$(aws ssm get-parameter --name "${jwt_secret_ssm_name}" --region $REGION --query Parameter.Value --output text --with-decryption)

sudo wget https://s3.amazonaws.com/amazoncloudwatch-agent/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb
sudo apt install ./amazon-cloudwatch-agent.deb -y
rm amazon-cloudwatch-agent.deb

cat <<-'CFG' | sudo tee /opt/aws/amazon-cloudwatch-agent/etc/config.json
{
    "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
    },
    "metrics": {
    "namespace": "${metrics_namespace}",
    "append_dimensions": {
        "InstanceId": "$${aws:InstanceId}",
        "InstanceType": "$${aws:InstanceType}",
        "AutoScalingGroupName": "$${aws:AutoScalingGroupName}"
    },
    "metrics_collected": {
        "cpu": {
        "measurement": ["cpu_usage_idle", "cpu_usage_user", "cpu_usage_system"],
        "totalcpu": true
        },
        "mem": { "measurement": ["mem_used_percent"] },
        "disk": {
        "measurement": ["used_percent"],
        "resources": ["/"]
        },
        "diskio": { "measurement": ["io_time"], "resources": ["*"] },
        "swap": { "measurement": ["swap_used_percent"] },
        "netstat": { "measurement": ["tcp_established", "tcp_time_wait"] }
    }
    },
    "logs": {
    "logs_collected": {
        "files": {
        "collect_list": [
            {
            "file_path": "/var/lib/docker/containers/*/*-json.log",
            "log_group_name": "${log_group_name}",
            "log_stream_name": "{instance_id}",
            "timezone": "UTC"
            }
        ]
        }
    }
    }
}
CFG
sudo /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
    -a fetch-config -m ec2 \
    -c file:/opt/aws/amazon-cloudwatch-agent/etc/config.json -s


sudo docker run -d --name backend-java -p 8080:8080 --restart always \
    -e SPRING_DATASOURCE_URL=jdbc:postgresql://$DB_ADDRESS:${db_port}/$DB_NAME \
    -e SPRING_DATASOURCE_USERNAME=$DB_USERNAME \
    -e SPRING_DATASOURCE_PASSWORD=$DB_PASSWORD \
    -e SPRING_DATA_REDIS_HOST=$REDIS_ADDRESS \
    -e SPRING_DATA_REDIS_PORT=${elasticache_cluster_port} \
    -e JWT_SECRET=$JWT_SECRET \
    fitcubes/backend:latest